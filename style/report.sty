% TEMPORARY plain template. Final design comes in the next step.
\ProvidesPackage{style/report}[2026/11/19 Temporary plain template]

% Page geometry: 2.5 cm margins + 0.5 cm binding offset (STY-02)
\RequirePackage[a4paper,margin=2.5cm,bindingoffset=0.5cm]{geometry}

% Language and fonts (LuaLaTeX + polyglossia)
\RequirePackage{fontspec}
\RequirePackage{polyglossia}
\setmainlanguage{hebrew}
\setotherlanguage{english}
\newfontfamily\hebrewfont[Script=Hebrew]{David}
\newfontfamily\hebrewfontsf[Script=Hebrew]{David}
\newfontfamily\hebrewfonttt[Script=Hebrew]{David}
\setmainfont{Times New Roman}
\setsansfont{Arial}
\setmonofont{Consolas}

% 1.5 line spacing, justified (STY-01)
\RequirePackage{setspace}
\onehalfspacing

% Table of contents down to level 3 (FRT-05)
\setcounter{tocdepth}{3}
\setcounter{secnumdepth}{3}

% Graphics, tables, links
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{tikz}
\RequirePackage{amsmath}
\RequirePackage[hidelinks]{hyperref}
